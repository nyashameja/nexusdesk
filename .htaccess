# Root-level protection for deployments where the document root CANNOT be
# moved to /public (shared cPanel without a subdomain docroot override).
#
# Preferred deployment: point the document root at /public. See README.md.
# When that is not possible, this file blocks direct access to application
# internals and rewrites public requests into /public.

# Block access to sensitive directories and files outright.
RedirectMatch 403 ^/?(app|bootstrap|config|database|routes|storage|vendor|tests)(/|$)
RedirectMatch 403 ^/?\.env
RedirectMatch 403 (?i).*\.(log|sql|md|lock|json|dist|example)$

<IfModule mod_rewrite.c>
    RewriteEngine On

    # If /public is not the docroot, transparently serve from it.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

Options -Indexes
