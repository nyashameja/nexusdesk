# Environment & secrets
.env
*.pem
*.key

# Dependencies
/vendor/

# Storage (runtime-generated)
/storage/cache/*
/storage/logs/*
/storage/sessions/*
!/storage/cache/.gitkeep
!/storage/logs/.gitkeep
!/storage/sessions/.gitkeep

# Uploads (keep the directory + its hardening rules, ignore uploaded files)
/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/.htaccess

# Install lock
/storage/installed.lock

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# PHPUnit
/.phpunit.cache/
.phpunit.result.cache
