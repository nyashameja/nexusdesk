# =====================================================================
# Paragon HostOps - Environment Configuration Example
# ---------------------------------------------------------------------
# Copy this file to ".env" and fill in the real values.
# The real ".env" file MUST NEVER be committed to version control.
# =====================================================================

APP_NAME="Paragon HostOps"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Johannesburg
APP_KEY=

# ----- Database -----
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=paragon_hostops
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ----- WHM / cPanel API -----
# The WHM host WITHOUT protocol or port, e.g. server1.example.com
WHM_HOST=
WHM_PORT=2087
WHM_USERNAME=
# Read-only WHM API token. Never displayed in the UI, logs, or API responses.
WHM_API_TOKEN=
WHM_VERIFY_SSL=true
WHM_TIMEOUT=30
WHM_CONNECT_TIMEOUT=10
# When true, the WhmApiClient reads canned fixtures instead of calling WHM.
# NEVER enable in production.
WHM_MOCK_MODE=false

# ----- Sessions -----
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=Lax

# ----- Security -----
# Long random secret required to trigger the web cron endpoints.
CRON_SECRET=

# Login throttling
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
