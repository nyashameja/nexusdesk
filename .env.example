# NexusDesk environment configuration
# Copy to .env (the installer writes this for you). Never commit .env.

APP_NAME="NexusDesk"
APP_ENV=production            # production | local
APP_DEBUG=false
APP_URL=https://support.example.com
APP_KEY=                      # 32+ byte base64 key; installer generates it
APP_TIMEZONE=UTC

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=nexusdesk
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Mail (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls           # tls | ssl | none
MAIL_FROM_ADDRESS=support@example.com
MAIL_FROM_NAME="NexusDesk Support"

# Security
SESSION_LIFETIME=120          # minutes (absolute)
SESSION_IDLE=30               # minutes (idle timeout)

# Zoho Books (optional; configured in admin)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REGION=com

# AI (optional; provider wired later)
AI_PROVIDER=null              # null | anthropic | openai
AI_API_KEY=
